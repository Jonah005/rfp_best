# --- application -------------------------------------------------------------
BIDREADY_ENV=development
BIDREADY_SECRET_KEY=change-me-in-every-environment
BIDREADY_ACCESS_TOKEN_TTL_MINUTES=30
BIDREADY_REFRESH_TOKEN_TTL_DAYS=14

# --- database ----------------------------------------------------------------
# The application role must NOT be superuser and must NOT have BYPASSRLS.
BIDREADY_DATABASE_URL=postgresql+psycopg://bidready_app:bidready@localhost:5432/bidready

# --- redis / celery ----------------------------------------------------------
BIDREADY_REDIS_URL=redis://localhost:6379/0
BIDREADY_CORS_ORIGINS=http://localhost:3000

# --- object storage (S3-compatible; MinIO in development) --------------------
BIDREADY_STORAGE_ENDPOINT_URL=http://localhost:9000
BIDREADY_STORAGE_ACCESS_KEY=minioadmin
BIDREADY_STORAGE_SECRET_KEY=minioadmin
BIDREADY_STORAGE_BUCKET=bidready
BIDREADY_STORAGE_REGION=us-east-1

# --- model gateway -----------------------------------------------------------
# Credentials come ONLY from the environment. Never commit a real key.
DEEPSEEK_API_KEY=
BIDREADY_LLM_PROVIDER=deepseek
BIDREADY_LLM_BASE_URL=https://api.deepseek.com
BIDREADY_LLM_MODEL=deepseek-chat
BIDREADY_LLM_TEMPERATURE=0.2
BIDREADY_LLM_TIMEOUT_SECONDS=60
BIDREADY_LLM_MAX_RETRIES=3

BIDREADY_EMBEDDING_PROVIDER=local
BIDREADY_EMBEDDING_MODEL=intfloat/multilingual-e5-base
